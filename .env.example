# ──────────────────────────────────────────────────────────────────────────────
# Fichier d'exemple de configuration — copiez-le en `.env` et renseignez les
# valeurs avant de lancer le projet.
# ──────────────────────────────────────────────────────────────────────────────

# Nom du Google Sheet à créer ou mettre à jour
GSHEET_NOM="Copro - Analyse"

# (Optionnel) Chemin vers le dossier contenant les credentials OAuth
# Par défaut : credentials/ (relatif au répertoire de travail)
# CREDENTIALS_DOSSIER=credentials

# (Optionnel) Chemin vers le dossier des CSV d'entrée
# Par défaut : data/csv/
# CSV_DOSSIER=data/csv

# (Optionnel) Chemin vers le fichier Parquet intermédiaire
# Par défaut : data/intermediaire/depenses.parquet
# DEPENSES_PARQUET=data/intermediaire/depenses.parquet
